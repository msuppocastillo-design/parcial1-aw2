# Puerto del servidor
PUERTO=3000

# Conexión a PostgreSQL (base "admin" con la tabla "usuarios")
BD_HOST=localhost
BD_PORT=5432
BD_USER=root
BD_PASS=pass
BD_BD=admin

# JWT: clave privada con la que se firma el token (usar un texto largo y aleatorio)
JWT_CLAVE=cambiar-por-una-clave-larga-y-secreta
# Minutos de vida del token. La cookie usa el mismo valor para caducar a la vez
JWT_EXPIRA_MINUTOS=60

# Cookie "secure": true solo si se sirve por HTTPS (en http://localhost debe ser false)
COOKIE_SECURE=false
